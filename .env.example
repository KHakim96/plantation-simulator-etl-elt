# Environment variable NAMES required by this project (NO real values/secrets).
# Copy to .env (git-ignored) and fill in real values locally.
# Loaded from the repository root via python-dotenv by the Phase 1 CLI entrypoints
# (upload_to_adls.py); generators read configuration from config.yaml.

# --- Phase 1: upload_to_adls.py (ADLS Gen2 Landing delivery) ---
# ADLS Gen2 storage account name (no protocol/host — just the account name).
AZURE_STORAGE_ACCOUNT=
# Account key used to sign ADLS REST requests. If unset, the uploader runs in
# DRY-RUN mode (no network calls). NEVER commit a real key.
AZURE_STORAGE_ACCOUNT_KEY=
# Landing container name (defaults to "landing" if unset). Landing ONLY.
ADLS_LANDING_CONTAINER=

# --- Informational: ADLS container names as created in Azure (no code reads
#     these in Phase 0/1; kept for operator reference and later phases) ---
AZURE_INCOMING_CONTAINER=incoming
AZURE_BRONZE_CONTAINER=bronze
AZURE_SILVER_CONTAINER=silver
AZURE_GOLD_CONTAINER=gold
AZURE_LIVE_BRONZE_CONTAINER=live-bronze
AZURE_LIVE_SILVER_CONTAINER=live-silver
AZURE_CHECKPOINT_CONTAINER=checkpoints

# --- Informational: Azure subscription / resource group (no code reads these
#     in Phase 0/1; needed for later phases) ---
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=

# --- Phase 8: Streamlit dashboard connections (NO real values/secrets) ---
# Historical path — Azure Synapse Serverless SQL (built-in endpoint, no dedicated pool).
# Server/host of the Synapse Serverless SQL endpoint.
SYNAPSE_SQL_SERVER=
# Database holding the Gold serving views (gold schema).
SYNAPSE_SQL_DATABASE=
# Authentication for the local dashboard's Synapse connection. Use an AAD
# interactive/SP login or SQL login supported by the endpoint. NAMES only here.
SYNAPSE_SQL_USERNAME=
SYNAPSE_SQL_PASSWORD=

# Live path — Databricks SQL (ONE shared serverless SQL Warehouse).
# Workspace host (no protocol, e.g. adb-<id>.<region>.azuredatabricks.net).
DATABRICKS_SQL_SERVER_HOSTNAME=
# HTTP path of the existing shared warehouse (e.g. /sql/1.0/warehouses/<id>).
DATABRICKS_SQL_HTTP_PATH=
# Access token for the Databricks SQL connection (PAT or OAuth token). NAMES only.
DATABRICKS_SQL_ACCESS_TOKEN=

# --- Future phase (Phase 9): ADF REST trigger service principal. EMPTY now. ---
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Optional: weather generator live mode (DISABLED for the batch pipeline) ---
# Leave empty so the deterministic mock generator runs. Setting a real key while
# generator_settings.weather_api.fallback_to_mock=false switches to live mode.
OPENWEATHER_API_KEY=
