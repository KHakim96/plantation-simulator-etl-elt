			"referenceName": "LS_Adls_PlantationSimulator",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"SinkContainer": {
				"type": "String",
				"defaultValue": "bronze"
			},
			"SinkFolder": {
				"type": "String"
			},
			"SinkFileName": {
				"type": "String"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().SinkFileName",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().SinkFolder",
					"type": "Expression"
				},
				"fileSystem": {
					"value": "@dataset().SinkContainer",
					"type": "Expression"
				}
			},
			"columnDelimiter": ",",
			"encodingName": "UTF-8",
			"quoteChar": "\"",
			"escapeChar": "\\",
			"firstRowAsHeader": true
		},
		"schema": []
	}
